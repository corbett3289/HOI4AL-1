	# create_equipment_variant.icon can bind the namespaced equipment-card key,
	# but a variant's name/country never participates in naval-combat lookups.
	# These combat aliases therefore belong only to the distinct
	# coi_alien_tic_tac_convoy equipment type and deliberately do not replace the
	# global GFX_unit_convoy_1_icon_medium or GFX_navalcombat_ship_icon_convoy.
	SpriteType = {
		name = "GFX_navalcombat_ship_icon_coi_alien_tic_tac_convoy"
		texturefile = "gfx/interface/navalcombat/ships/coi_alien_tic_tac_convoy.dds"
		noOfFrames = 2
	}
